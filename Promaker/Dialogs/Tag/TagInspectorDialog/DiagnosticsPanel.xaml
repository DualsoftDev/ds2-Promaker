<UserControl x:Class="Promaker.Dialogs.TagInspectorDiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- IO·태그 확인 다이얼로그의 진단 패널. 버튼 클릭은 이벤트로 다이얼로그 핸들러에 그대로 넘긴다. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DiagnosticsHeaderText"
                           x:FieldModifier="internal"
                           Grid.Column="0"
                           Text="진단"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="✖"
                        Width="22" Height="22"
                        Padding="0"
                        ToolTip="진단 패널 닫기"
                        Click="DiagnosticsClose_Click"/>
            </Grid>

            <ItemsControl Grid.Row="1"
                          x:Name="DiagnosticsList"
                          x:FieldModifier="internal"
                          MaxHeight="220">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DiagnosticCardStyle}"
                                BorderBrush="{Binding AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           Foreground="{Binding AccentBrush}"
                                           FontSize="16"
                                           Margin="0,1,8,0"
                                           VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding Detail}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding RawMessage}"
                                               Visibility="{Binding HasRawMessage, Converter={StaticResource BoolToVis}}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource DisabledTextBrush}"
                                               FontFamily="Consolas, Cascadia Mono, Menlo, monospace"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top"
                                            Margin="8,0,0,0">
                                    <Button Content="🔧 FBTagMap 편집"
                                            Padding="8,3"
                                            Margin="0,0,6,0"
                                            FontSize="11"
                                            ToolTip="이 SystemType 의 신호 템플릿을 편집하기 위해 TAG Wizard 를 엽니다."
                                            Visibility="{Binding CanOpenFBTagMap, Converter={StaticResource BoolToVis}}"
                                            Click="DiagnosticOpenFBTagMap_Click"/>
                                    <Button Content="📍 해당 행 보기"
                                            Padding="8,3"
                                            FontSize="11"
                                            Visibility="{Binding HasAffectedRows, Converter={StaticResource BoolToVis}}"
                                            Click="DiagnosticGoToRow_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
