<Window x:Class="Promaker.Dialogs.TagInspectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Promaker.Dialogs"
        Title="IO·태그 확인"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="I/O 조회"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="(읽기 전용 — 편집은 TAG Wizard 에서만 가능)"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="12,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>

            <!-- 필터는 그리드 컬럼 헤더 안으로 이전됨. 조회 전용이므로 편집 버튼 제거. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource DarkButton}"
                            Content="🔄 새로고침"
                            MinWidth="110"
                            Padding="8,4"
                            Click="Refresh_Click"
                            ToolTip="현재 store 의 매크로/Preset 으로 IO 신호 재생성"/>
                    <!-- System(PLC) 필터 — 멀티 PLC 프로젝트에서 주소 조회를 System 단위로 스코핑.
                         IO 신호 / 사용자 태그 탭에 공통 적용. -->
                    <TextBlock Text="System"
                               VerticalAlignment="Center"
                               Margin="14,0,6,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox x:Name="SystemFilterCombo"
                              MinWidth="160"
                              VerticalContentAlignment="Center"
                              SelectionChanged="SystemFilterCombo_SelectionChanged"
                              ToolTip="System(=PLC 1대) 단위로 IO 신호와 사용자 태그를 필터링합니다"/>
                </StackPanel>

                <!-- 상태 칩: 클릭 시 진단 패널 토글 (오류/경고가 있을 때) -->
                <StackPanel Grid.Column="1"
                            x:Name="StatusChipsPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Button x:Name="TotalChip"
                            Style="{StaticResource StatusChipStyle}"
                            Background="{DynamicResource TertiaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            IsHitTestVisible="False"
                            Content="총 0"
                            ToolTip="현재 화면에 보이는 행 / 전체 행 수"/>
                    <Button x:Name="WarningChip"
                            Style="{StaticResource StatusChipStyle}"
                            Background="#33F2B134"
                            BorderBrush="{DynamicResource OrangeAccentBrush}"
                            Foreground="{DynamicResource OrangeAccentBrush}"
                            Visibility="Collapsed"
                            Click="DiagnosticsChip_Click"
                            ToolTip="경고 — 클릭하면 진단 패널이 열립니다"/>
                    <Button x:Name="ErrorChip"
                            Style="{StaticResource StatusChipStyle}"
                            Background="#33E15B5B"
                            BorderBrush="{DynamicResource RedAccentBrush}"
                            Foreground="{DynamicResource RedAccentBrush}"
                            Visibility="Collapsed"
                            Click="DiagnosticsChip_Click"
                            ToolTip="오류 — 클릭하면 진단 패널이 열립니다"/>
                </StackPanel>

                <CheckBox x:Name="ShowOnlyUnmatchedCheckBox"
                          Grid.Column="2"
                          Content="미매치만 보기"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Checked="ShowOnlyUnmatched_Changed"
                          Unchecked="ShowOnlyUnmatched_Changed"/>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource TertiaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <TabControl x:Name="MainTabControl"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem x:Name="IoTab" Header="IO 신호">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 진단 패널 — 칩 클릭 시 토글. 항목이 없으면 자동 숨김. -->
                    <local:TagInspectorDiagnosticsPanel x:Name="DiagnosticsPanel"
                                                        Grid.Row="0"
                                                        Visibility="Collapsed"
                                                        CloseClick="DiagnosticsClose_Click"
                                                        OpenFBTagMapClick="DiagnosticOpenFBTagMap_Click"
                                                        GoToRowClick="DiagnosticGoToRow_Click"/>

                    <local:TagInspectorIoFilterHeader x:Name="IoFilterHeader"
                                                      Grid.Row="1"
                                                      FilterTextChanged="FilterTextBox_TextChanged"/>

                    <DataGrid x:Name="IoGrid"
                              Grid.Row="2"
                              Style="{StaticResource BatchGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              BeginningEdit="IoGrid_BeginningEdit"
                              PreviewKeyDown="IoGrid_PreviewKeyDown"
                              HeadersVisibility="None"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              LayoutUpdated="IoGrid_LayoutUpdated"
                              PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <!-- 우선순위: HasError(파이프라인 매칭) > IsUnmatched(매핑 미완) -->
                                    <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                                        <Setter Property="Background" Value="#55F2B134"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#66E15B5B"/>
                                    </DataTrigger>
                                    <!-- 표에서 고쳤고 아직 적용 안 한 행 (#212) -->
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="선택 항목 체크" Click="CheckSelected_Click"/>
                                <MenuItem Header="선택 항목 체크 해제" Click="UncheckSelected_Click"/>
                                <Separator/>
                                <MenuItem Header="전체 체크" Click="CheckAll_Click"/>
                                <MenuItem Header="전체 체크 해제" Click="UncheckAll_Click"/>
                                <Separator/>
                                <MenuItem Header="선택 항목 I/O 삭제" Click="DeleteSelectedIo_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="RowCheckBox_Click"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Flow}"   Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding Work}"   Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding Device}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding Api}"    Width="140" IsReadOnly="True"/>
                            <!-- In/Out 이름·주소는 표에서 바로 고친다 (#212) — '변경 적용' 으로 반영 -->
                            <DataGridTextColumn Binding="{Binding InSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Width="*"/>
                            <DataGridTextColumn Binding="{Binding InDataType}"  Width="80"  IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding InAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="120"/>
                            <DataGridTextColumn Binding="{Binding OutSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Width="*"/>
                            <DataGridTextColumn Binding="{Binding OutDataType}" Width="80"  IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding OutAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                    </TabItem>

                    <TabItem x:Name="DummyTab" Header="Dummy 신호">
                        <DataGrid x:Name="DummyGrid"
                                  Style="{StaticResource BatchGridStyle}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Flow"     Binding="{Binding Flow}"     Width="120"/>
                                <DataGridTextColumn Header="Work"     Binding="{Binding Work}"     Width="140"/>
                                <DataGridTextColumn Header="Call"     Binding="{Binding Call}"     Width="160"/>
                                <DataGridTextColumn Header="Symbol"   Binding="{Binding Symbol}"   Width="*"/>
                                <DataGridTextColumn Header="DataType" Binding="{Binding DataType}" Width="80"/>
                                <DataGridTextColumn Header="Address"  Binding="{Binding Address}"  Width="120"/>
                                <DataGridTextColumn Header="Type"     Binding="{Binding Type}"     Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem x:Name="UserTagsTab" Header="사용자 태그">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 단순 텍스트 필터 (System/Name/Address) -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="검색"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="UserTagSearchBox"
                                             Padding="4,3"
                                             ToolTip="System / 이름 / 주소 / 값 타입 통합 검색"
                                             TextChanged="UserTagSearch_TextChanged"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource DarkButton}"
                                            Content="📥 CSV 내보내기"
                                            Margin="8,0,0,0"
                                            Padding="10,3"
                                            MinWidth="140"
                                            Click="UserTagCsvExport_Click"
                                            ToolTip="사용자 태그 탭의 현재 필터 적용된 행을 CSV 로 저장"/>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      x:Name="UserTagsGrid"
                                      Style="{StaticResource BatchGridStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="System"     Binding="{Binding SystemName}" Width="160"/>
                                    <DataGridTextColumn Header="이름"        Binding="{Binding Name}"       Width="*"/>
                                    <DataGridTextColumn Header="로그 레벨"   Binding="{Binding LogLevel}"   Width="90"/>
                                    <DataGridTextColumn Header="태그 주소"   Binding="{Binding TagAddress}" Width="140"/>
                                    <DataGridTextColumn Header="값 타입"     Binding="{Binding ValueType}"  Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 선택 카운트 표시만 (자동 생성 섹션 제거 — 조회 전용) -->
            <Border Grid.Row="5"
                    Background="{DynamicResource TertiaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡 I/O 이름·주소는 표에서 바로 고친 뒤 '변경 적용' 을 누르세요. 패턴으로 한꺼번에 만들 때는 TAG Wizard 를 쓰세요."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"/>
                    <TextBlock Text="   |   선택:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="16,0,4,0"/>
                    <TextBlock x:Name="SelectedCountText"
                               Text="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        MinWidth="160"
                        Style="{StaticResource DarkButton}"
                        Content="📥 IO CSV 내보내기"
                        Click="ExportIoCsv_Click"
                        ToolTip="IO 신호 탭의 현재 필터 적용된 행을 CSV 로 저장"/>

                <Button Grid.Column="2"
                        MinWidth="180"
                        Style="{StaticResource DarkButton}"
                        Content="📥 Dummy CSV 내보내기"
                        Click="ExportDummyCsv_Click"
                        ToolTip="Dummy 신호 탭의 모든 행을 CSV 로 저장"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="ApplyIoButton"
                            MinWidth="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource DarkButton}"
                            Content="변경 적용"
                            IsEnabled="False"
                            Click="ApplyIo_Click"
                            ToolTip="IO 신호 탭에서 고친 이름·주소를 모델에 반영 (Undo 한 번)"/>
                    <Button MinWidth="82"
                            Style="{StaticResource DarkButton}"
                            Content="닫기"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
