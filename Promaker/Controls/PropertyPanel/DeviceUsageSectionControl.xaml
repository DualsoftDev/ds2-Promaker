<UserControl x:Class="Promaker.Controls.DeviceUsageSectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Promaker.Presentation"
             x:Name="Root">
    <!-- Device(Passive) System 속성 패널의 "사용 현황" 섹션 (#263). DataContext 는 PropertyPanelState(부모 상속).
         Device 는 독립 System 이라 여러 System 이 같이 쓸 수 있어, 소속이 아니라 어디에 쓰이는지를 나열한다. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="0,2,0,8"
            Visibility="{Binding ShowDeviceUsage, Converter={StaticResource BoolToVis}}"
            Background="{DynamicResource TertiaryBackgroundBrush}">
        <StackPanel>
            <Border Background="{DynamicResource SecondaryBackgroundBrush}" Padding="4,3">
                <TextBlock Text="{Binding DeviceUsageHeader}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Border>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeviceUsages}" Margin="4,2,4,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding Path}">
                                <TextBlock Text="{Binding Path}" FontSize="11"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding ApiName, StringFormat=' · {0}'}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text=" (조건)" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Visibility="{Binding IsCondition, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
