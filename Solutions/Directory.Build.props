<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Dualsoft</Authors>
    <Company>Dualsoft</Company>
    <Product>DS System</Product>
    <Copyright>Copyright © Dualsoft 2025</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DualsoftDev/ds2.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DualsoftDev/ds2</PackageProjectUrl>
  </PropertyGroup>

  <!-- Promaker 저장소 전체(Apps/Promaker 와 Solutions/ 의 모든 프로젝트) 버전의 SSOT = Apps/Promaker/BuildVersion.txt. csproj 에 <Version> 을 두지 않는다 —
       매 빌드 시 이 props 가 값을 읽어 Version / AssemblyVersion / FileVersion 에 주입한다. -->
  <PropertyGroup>
    <PromakerVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../Apps/Promaker/BuildVersion.txt').Trim())</PromakerVersion>
    <Version>$(PromakerVersion)</Version>
    <AssemblyVersion>$(PromakerVersion)</AssemblyVersion>
    <FileVersion>$(PromakerVersion)</FileVersion>
  </PropertyGroup>

  <!-- Release 빌드 설정 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Debug 빌드 설정 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- F# 특정 설정 -->
  <PropertyGroup>
    <OtherFlags>$(OtherFlags) --warnon:1182</OtherFlags>
  </PropertyGroup>
</Project>
